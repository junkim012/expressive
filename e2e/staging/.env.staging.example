# Monad Testnet staging config
# Copy to .env.staging and fill in deployed values
#
#   cp e2e/staging/.env.staging.example e2e/staging/.env.staging

RPC_URL=https://testnet-rpc.monad.xyz
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
START_BLOCK=0
SOLVER_FEE_RATE=10

# Token addresses on Monad testnet (MockERC20 contracts)
USDC=0x0000000000000000000000000000000000000000
WBTC=0x0000000000000000000000000000000000000000
WETH=0x0000000000000000000000000000000000000000

# Oracle addresses on Monad testnet
BTC_ORACLE=0x0000000000000000000000000000000000000000
ETH_ORACLE=0x0000000000000000000000000000000000000000

# ── Funding (make fund-staging) ──────────────────────────────────────────────
# Any funded EOA — used to pay gas when minting mock tokens.
# The mock tokens have permissionless mint(), so this key only needs MON for gas.
FUNDER_KEY=0x...

# ── Solver bots (make solver MODE=staging) ───────────────────────────────────
SOLVER1_KEY=0x...
SOLVER2_KEY=0x...
SOLVER3_KEY=0x...

# ── Lender bots (make lender MODE=staging) ───────────────────────────────────
LENDER1_KEY=0x...
LENDER2_KEY=0x...

# ── Borrower bots (make borrower MODE=staging) ──────────────────────────────
BORROWER1_KEY=0x...
BORROWER2_KEY=0x...
